{
  "name": "lite-pack-web",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "node scripts/dev-demo.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173",
    "sitemap": "node scripts/sitemap.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sitemap:snapshot": "node scripts/sitemap.mjs --snapshot",
    "build:spa": "tsc --noEmit -p tsconfig.json && vite build",
    "snapshot": "node tools/crawl.mjs",
    "images": "node tools/enhance-images.mjs",
    "preview:netlify": "node scripts/netlify-preview.mjs",
    "preview:static": "node scripts/static-preview.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geologica": "5.3.0",
    "@fontsource-variable/onest": "5.3.1",
    "lenis": "^1.3.17",
    "preact": "^10.25.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "preact-render-to-string": "^6.5.13",
    "typescript": "5.6.3",
    "vite": "5.4.21"
  }
}
